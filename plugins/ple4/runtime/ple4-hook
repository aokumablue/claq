#!/bin/sh
# ple4 hook launcher — POSIX side.
#
# hooks.json calls this file (never a bare `python3`) so that the interpreter
# name is resolved by code we control instead of by whatever the host's ambient
# PATH happens to bind. On Windows the very same command string resolves to the
# sibling `ple4-hook.cmd` (cmd.exe appends PATHEXT to an extension-less path),
# so a single hooks.json entry serves all three platforms.
#
# Resolution order: $PLE4_PYTHON (explicit override) -> python3 -> python.
# `python` is probed for 3.12+ before use because on some distributions it is
# still Python 2, which cannot even parse launcher.py. `python3` is used
# unprobed: probing costs one extra interpreter start on every single hook
# invocation, and launcher.py already reports an unsupported version itself.
#
# When nothing usable is found this exits 0 after writing a diagnostic to
# stderr, matching launcher.py's documented fail-open policy (see CLAUDE.md
# "ランタイム前提"): the runtime ships no venv and no installer, so a
# fail-closed exit would block the very Bash tool needed to repair PATH and
# would make the session unrecoverable from the inside.

# `dirname` is deliberately not used: it is an external binary, and this script
# must still resolve its own root when PATH is empty or broken — which is
# exactly the situation the wrapper exists to diagnose. `cd`/`pwd` are builtins.
case "$0" in
  */*) _ple4_hook_dir=${0%/*} ;;
  *) _ple4_hook_dir=. ;;
esac
# `cd` が失敗してもここでは抜けない。root が解決できなければ launcher も
# 見つからず、下の存在検査が診断付きの fail-open で終わらせる。以前はこの行で
# 無言の exit 0 をしており、保護が無効化されたことが誰にも観測できなかった。
_ple4_root=$(CDPATH= cd -- "$_ple4_hook_dir/.." && pwd)
_ple4_launcher="$_ple4_root/src/ple4/launcher.py"

# インタプリタ選択より **前** に launcher の存在を確かめる。3 つの exec 経路は
# どれも同じファイルを渡すため、ここを通さないと不在時に全経路が同じ形で壊れる。
#
# `python3 <存在しないファイル>` は **exit 2** を返す。PreToolUse の「exit 2 =
# deny」契約により、不完全インストール・Grok の hash symlink 切れ・root 解決の
# 失敗はいずれも「4 つの保護 hook が全ツール呼び出しを偽 deny する」という形に
# 化けていた。これは上に書いた fail-open ポリシーの真逆であり、しかも復旧手段の
# Bash ごと塞ぐためセッション内から直せない。読めない launcher も python 側は
# 同じ exit 2 になるので、存在と可読性を一度に見る。
if [ ! -f "$_ple4_launcher" ] || [ ! -r "$_ple4_launcher" ]; then
  printf '%s\n' "ERROR: ple4 launcher is missing or unreadable at $_ple4_launcher. Hooks are disabled until the plugin install is repaired (reinstall the plugin; on Grok re-run scripts/grok.sh to relink the hashed install directory)." >&2
  printf '%s%s%s\n' '{"ple4ProtectionDisabled": true, "reason": "launcher_not_found", "launcher": "' "$_ple4_launcher" '"}' >&2
  exit 0
fi

if [ -n "${PLE4_PYTHON:-}" ]; then
  exec "$PLE4_PYTHON" "$_ple4_launcher" "$@"
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$_ple4_launcher" "$@"
fi

if command -v python >/dev/null 2>&1 &&
  python -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' >/dev/null 2>&1; then
  exec python "$_ple4_launcher" "$@"
fi

printf '%s\n' "ERROR: ple4 found no usable Python 3.12+ (tried PLE4_PYTHON, python3, python). Hooks are disabled until one is on PATH; set PLE4_PYTHON to an absolute interpreter path to recover." >&2
printf '%s\n' '{"ple4ProtectionDisabled": true, "reason": "python_not_found", "candidates": ["PLE4_PYTHON", "python3", "python"], "requiredVersion": "3.12+"}' >&2
exit 0
