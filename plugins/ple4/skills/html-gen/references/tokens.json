  "contrast_fixes": [
    {
      "var": "ring",
      "against": "background",
      "min_ratio": 3.0,
      "reason": "フォーカスリングは WCAG 2.1 SC 1.4.11 の非テキストコントラスト対象。upstream の L=0.70 台は白背景に 2.58〜2.63:1 で不足するため、hue と chroma を保ったまま L だけ下げて 3:1 を満たす最大値を採る。"
    },
    {
      "var": "sidebar-ring",
      "against": "sidebar",
      "min_ratio": 3.0,
      "reason": "サイドバー面のフォーカスリングも本文側と同じ 1.4.11 の対象。sidebar 面に対して 3:1 を満たす最大の明度を採る。"
    },
    {
      "var": "muted-foreground",
      "against": "muted",
      "min_ratio": 4.5,
      "reason": "muted 面の上に置く補助テキストが upstream のライトでは 4.35〜4.39:1。L だけ下げて 4.5:1 を満たす最大値を採る（差は 0.01 前後で見た目は変わらない）。"
    }
  ],
  "derived_roles": {
    "destructive-foreground": {
      "reason": "shadcn v4 は destructive ボタンの前景をユーティリティ（text-white）で当てるためレジストリに変数が無い。静的 CSS では変数が要るので、destructive に対して4.5:1 を満たす側を明示する。ダークの destructive は明るい赤なので前景は暗色。",
      "light": "oklch(0.985 0 0)",
      "dark": "oklch(0.205 0 0)",
      "min_ratio": 4.5
    }
  },
  "series": {
    "reason": "upstream の chart-1..5 は 2 つの理由でデータ可視化に使えない。(1) neutral / zinc / stone はグレースケールで相互 ΔE*ab が 8 前後しかなく系列が判別できない。(2) ライトの chart-1 は白背景に 1.48:1、ダークの chart-5 はカード面に 1.15:1 で描画しても見えない。そこで色相と彩度は upstream のダークセット（5 色が色相環に散っており、ライト/ダークで系列の色が入れ替わらない）を全ベースで採り、明度だけ固定してコントラストと相互距離の契約を満たす。",
    "hues": [
      264.376,
      162.48,
      70.08,
      303.9,
      16.439
    ],
    "chromas": [
      0.243,
      0.17,
      0.188,
      0.265,
      0.246
    ],
    "light_lightness": 0.58,
    "dark_lightness": 0.75,
    "count": 5,
    "min_ratio": 3.0,
    "min_delta_e": 20.0
  },
  "decorative_roles": {
    "reason": "border / input / sidebar-border は 1px のヘアラインで、ライトでは背景に対し 1.2:1 しかない。shadcn の面分離はこの線と余白が担い、色でコンポーネントの状態を伝えてはいないのでSC 1.4.11 の対象外として 3:1 契約から外す。ただし背景と同値になると面が消えるため、min_ratio だけは別に課す。",
    "vars": [
      "border",
      "input",
      "sidebar-border"
    ],
    "min_ratio": 1.1
  },
