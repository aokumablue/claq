{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|bash|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.block_no_verify"
          }
        ],
        "description": "git hook-bypassフラグをブロックして、pre-commit、commit-msg、pre-pushフックがスキップされないように保護します。"
      },
      {
        "matcher": "^(Bash|bash|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.pre_bash_commit_quality"
          }
        ],
        "description": "コミット前の品質チェック：ステージングされたファイルのリンティング、コミットメッセージのフォーマット検証、コミット前にconsole.log/debugger/secretsを検出します。"
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|edit|write|multiedit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.config_protection",
            "timeout": 5
          }
        ],
        "description": "linter/formatterの設定ファイルへの変更をブロックします。エージェントが設定を弱めるのではなく、コードを修正するように導きます。"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" --bg bluecore.skills.learn.observe pre",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "キャプチャツールの使用状況を観察して継続的な学習に役立てる"
      },
      {
        "matcher": "^(Task|task|Agent|agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.pre_agent_nudge",
            "timeout": 5
          }
        ],
        "description": "general-purpose サブエージェント起動時に bluecore 専門エージェント対応表を additionalContext で提示します（非ブロック）"
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.pre_compact"
          }
        ],
        "description": "コンテキストの圧縮前に状態を保存します"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.session_install",
            "timeout": 60
          }
        ],
        "description": "プラグイン初回/更新時に install.sh を実行し settings.json と plugin_installed_version を整える"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.mem.cli context",
            "timeout": 60
          }
        ],
        "description": "永続メモリから共通知識・リポジトリ知識・前回の引き継ぎを <bluecore-memory> として注入する（DB が無ければ作成）"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.session_start"
          }
        ],
        "description": "新しいセッションで以前のコンテキストを読み込み、パッケージマネージャを検出する"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|bash|shell)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.redux_filter",
            "timeout": 10
          }
        ],
        "description": "redux: Bash 出力をコマンド別フィルタで圧縮（無一致時は汎用戦略でトークン削減）"
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|edit|write|multiedit|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" bluecore.hooks.quality_gate post-edit",
            "timeout": 15
          }
        ],
        "description": "編集後の品質ゲートを settings.json の hooks.quality-gate 設定に従って実行します"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" --bg bluecore.hooks.session_end",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "各応答後もセッション状態を保持する（停止時にはtranscript_pathが保持される）"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" --bg bluecore.hooks.desktop_notify",
            "async": true,
            "timeout": 5
          }
        ],
        "description": "応答完了時にタスクサマリー付きデスクトップ通知を送信します（macOS: osascript、WSL: PowerShell + BurntToast）"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/src/bluecore/launcher.py\" --bg bluecore.mem.cli handoff",
            "async": true,
            "timeout": 10
          }
        ],
        "description": "セッション終了時に次セッションへの引き継ぎを sessions.handoff へ記録する（非ブロッキング）"
      }
    ]
  }
}
