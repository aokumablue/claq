[project]
name = "example-server"
version = "0.1.0"
description = "MCP server (protocol 2026-07-28)"
requires-python = ">=3.10"
# 2.x で `FastMCP` → `MCPServer` に改名された。3.x で再度変わりうるため上限を張る。
# 2.1.1 は mcp_types.LATEST_PROTOCOL_VERSION == "2026-07-28" を実測確認済みの版。
dependencies = ["mcp>=2.1.1,<3"]

[project.scripts]
example-server = "server:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
